root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning

# LoggerMessage source generators add ceremony that doesn't pay off at this app's log volume.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# EF-generated; regenerated by tooling, not hand-edited.
[**/Migrations/*.cs]
generated_code = true

# Test names read as sentences.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

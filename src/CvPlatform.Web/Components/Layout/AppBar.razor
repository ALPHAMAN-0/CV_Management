@using System.Globalization
@implements IDisposable
@inject NavigationManager Navigation

@* Shared by MainLayout (interactive) and AccountLayout (static SSR), so every action is a plain
   link or form that works without a circuit. Only the signed-in menu needs interactivity, and the
   static sign-in pages are only ever seen signed out. *@
<MudAppBar Elevation="1">
    @if (OnMenuClick.HasDelegate)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="OnMenuClick" aria-label="@L["Menu"]" />
    }
    <MudLink Href="" Color="Color.Inherit" Underline="Underline.None" Class="d-flex align-center gap-2">
        <MudIcon Icon="@Icons.Material.Filled.Description" />
        <MudText Typo="Typo.h6" Class="d-none d-sm-flex">CV Platform</MudText>
    </MudLink>

    <MudSpacer />

    <form action="search" method="get" role="search" class="mx-2" style="max-width: 320px">
        <MudTextField T="string" name="q" Placeholder="@L["Search"]" aria-label="@L["Search"]"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="appbar-search"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    </form>

    @* A POST that sets a cookie (and saves the choice for signed-in users), then reloads the page:
       a circuit's culture is fixed when it starts, so language needs the reload anyway, and the
       theme reuses the same simple path. *@
    <form action="Preferences/Culture" method="post">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <MudButton ButtonType="ButtonType.Submit" name="culture" value="@otherCulture.Name"
                   Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Translate" aria-label="@L["Language"]">
            <span class="d-none d-sm-inline">@otherCulture.NativeName</span>
        </MudButton>
    </form>
    <form action="Preferences/Theme" method="post">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <MudIconButton ButtonType="ButtonType.Submit" name="theme" value="@(DarkMode ? Preferences.Light : Preferences.Dark)"
                       Icon="@(DarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" aria-label="@(DarkMode ? L["Light mode"] : L["Dark mode"])" />
    </form>

    <AuthorizeView>
        <Authorized>
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" aria-label="@L["Account"]"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudText Typo="Typo.body2" Class="px-4 py-2">@context.User.Identity?.Name</MudText>
                <MudDivider />
                @* Sign-out must be a POST with an antiforgery token, so it is a real form. *@
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Logout">@L["Sign out"]</MudButton>
                </form>
            </MudMenu>
        </Authorized>
        <NotAuthorized>
            <MudButton Href="Account/Login" Variant="Variant.Text" Color="Color.Inherit"
                       StartIcon="@Icons.Material.Filled.Login" aria-label="@L["Sign in"]">
                <span class="d-none d-sm-inline">@L["Sign in"]</span>
            </MudButton>
        </NotAuthorized>
    </AuthorizeView>
</MudAppBar>

@code {
    private string returnUrl = "";

    // With two languages the switch offers the one that isn't active.
    private readonly CultureInfo otherCulture = CultureInfo.GetCultureInfo(
        Preferences.Cultures.First(c => c != CultureInfo.CurrentUICulture.TwoLetterISOLanguageName));

    // Set only by MainLayout: the static layout has no drawer to toggle.
    [Parameter]
    public EventCallback OnMenuClick { get; set; }

    [CascadingParameter(Name = "DarkMode")]
    private bool DarkMode { get; set; }

    protected override void OnInitialized()
    {
        returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
    }

    // Keeps the forms' return address current as the user navigates inside the circuit.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        returnUrl = Navigation.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}

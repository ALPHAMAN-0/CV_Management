@inherits LayoutComponentBase

@* For the static sign-in pages: presentational only, because nothing here runs on a circuit.
   The theme comes from the provider App.razor renders. No drawer: it would need a circuit to
   toggle, and an anonymous visitor's only destination, Home, is the logo link. *@
<MudLayout>
    <AppBar />
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

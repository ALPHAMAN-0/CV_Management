@using System.Globalization

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CvPlatform.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    @* Rendered here too, in the first HTTP response, so the page has its colours before the circuit
       connects (no white flash in dark mode) and static pages need no provider of their own. *@
    <MudThemeProvider IsDarkMode="DarkMode" ObserveSystemDarkModeChange="false" />
    <Routes @rendermode="PageRenderMode" DarkMode="DarkMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Prerendering would run every page twice (static + interactive) and double its queries.
    // Identity account pages opt out of interactive routing and stay static SSR.
    private static readonly IComponentRenderMode InteractiveServerNoPrerender =
        new InteractiveServerRenderMode(prerender: false);

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServerNoPrerender : null;

    // Read here because only this component sees the HTTP request; Routes passes it on.
    private bool DarkMode => Preferences.IsDark(HttpContext.Request);
}

@* Shows the one-shot message a redirect left in a cookie. Every message left this way is an error. *@
@if (!string.IsNullOrEmpty(message))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@message</MudAlert>
}

@code {
    private string? message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized()
    {
        message = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (message is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}

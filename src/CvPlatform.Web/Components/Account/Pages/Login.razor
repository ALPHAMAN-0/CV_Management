@page "/Account/Login"

@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using CvPlatform.Web.Data

@inject SignInManager<ApplicationUser> SignInManager

<PageTitle>Log in</PageTitle>

<h1>Log in</h1>
<StatusMessage />

@if (providers.Length == 0)
{
    <p>No sign-in providers are configured.</p>
}
else
{
    <form action="Account/PerformExternalLogin" method="post">
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        @foreach (var provider in providers)
        {
            <button type="submit" class="btn btn-primary me-2" name="provider" value="@provider.Name">@provider.DisplayName</button>
        }
    </form>
}

@code {
    private AuthenticationScheme[] providers = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Drop any half-finished external sign-in so every attempt starts clean.
        await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        providers = [.. await SignInManager.GetExternalAuthenticationSchemesAsync()];
    }
}

@page "/Account/Login"

@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using CvPlatform.Web.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@L["Sign in"]</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">@L["Sign in"]</MudText>
<StatusMessage />

@if (providers.Length == 0)
{
    <MudText>@L["No sign-in providers are configured."]</MudText>
}
else
{
    <form action="Account/PerformExternalLogin" method="post" class="d-flex flex-column gap-3">
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        @foreach (var provider in providers)
        {
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Large" name="provider" value="@provider.Name">
                @L["Continue with {0}", provider.DisplayName ?? provider.Name]
            </MudButton>
        }
    </form>
}

@code {
    private AuthenticationScheme[] providers = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Signed-in users have nothing to do here (and this static page can't run their menu).
        if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            RedirectManager.RedirectTo(ReturnUrl);
            return;
        }

        // Drop any half-finished external sign-in so every attempt starts clean.
        await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        providers = [.. await SignInManager.GetExternalAuthenticationSchemesAsync()];
    }
}

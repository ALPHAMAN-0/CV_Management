@page "/Account/ExternalLogin"

@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using CvPlatform.Web.Data
@using CvPlatform.Web.Features.Account

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject UserOnboarding Onboarding
@inject IdentityRedirectManager RedirectManager

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? RemoteError { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    // Finishes the provider's callback. Every path ends in a redirect, so the page has no markup.
    protected override async Task OnInitializedAsync()
    {
        if (RemoteError is not null)
        {
            Fail($"Error from the sign-in provider: {RemoteError}");
            return;
        }

        var info = await SignInManager.GetExternalLoginInfoAsync();
        if (info is null)
        {
            Fail("Sign-in information could not be loaded. Please try again.");
            return;
        }

        var ct = HttpContext.RequestAborted;
        var user = await UserManager.FindByLoginAsync(info.LoginProvider, info.ProviderKey);
        if (user is not null)
        {
            // Before the cookie is issued, so the cookie carries the user's roles.
            await Onboarding.EnsureSetUpAsync(user, ct);
            var result = await SignInManager.ExternalLoginSignInAsync(
                info.LoginProvider, info.ProviderKey, isPersistent: false, bypassTwoFactor: true);

            if (result.Succeeded)
            {
                RedirectManager.RedirectTo(ReturnUrl);
            }
            else if (result.IsLockedOut)
            {
                RedirectManager.RedirectTo("Account/Lockout");
            }
            else
            {
                Fail("Sign-in failed. Please try again.");
            }
            return;
        }

        // Only provider-verified addresses reach this point (see Program.cs), so the email
        // identifies the person. Without one we can't create or link an account safely.
        var email = info.Principal.FindFirstValue(ClaimTypes.Email);
        if (string.IsNullOrEmpty(email))
        {
            Fail($"{info.ProviderDisplayName} did not share a verified email address. Verify one there, or use another provider.");
            return;
        }

        user = await UserManager.FindByEmailAsync(email);
        if (user is null)
        {
            user = new ApplicationUser { UserName = email, Email = email, EmailConfirmed = true };
            var created = await UserManager.CreateAsync(user);
            if (!created.Succeeded)
            {
                Fail(Describe(created));
                return;
            }
        }
        else if (await UserManager.IsLockedOutAsync(user))
        {
            // Blocked users must not get back in by linking a second provider.
            RedirectManager.RedirectTo("Account/Lockout");
            return;
        }

        // The same verified email from Google and GitHub is the same person: one account, two logins.
        var linked = await UserManager.AddLoginAsync(user, info);
        if (!linked.Succeeded)
        {
            Fail(Describe(linked));
            return;
        }

        await Onboarding.EnsureSetUpAsync(user, ct);
        await SignInManager.SignInAsync(user, isPersistent: false, info.LoginProvider);
        RedirectManager.RedirectTo(ReturnUrl);
    }

    private void Fail(string message) =>
        RedirectManager.RedirectToWithStatus("Account/Login", message, HttpContext);

    private static string Describe(IdentityResult result) =>
        string.Join(" ", result.Errors.Select(error => error.Description));
}
